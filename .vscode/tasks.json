{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译当前cpp",
      "type": "process",
      // 【原硬编码】"command": "D:/bigdevtools/msys64/clang64/bin/clang++.exe",
      "command": "${env:MSYS64_HOME}/clang64/bin/clang++.exe",
      "args": [
        "-g",
        "-O0",
        "-std=c++20",
        "-Wall",
        "-Wextra",
        // ★ 新增：静态链接 C++ 运行时（libc++/libc++abi/libunwind/libwinpthread），
        //   生成不依赖 libc++.dll 等动态库的独立 exe
        "-static",
        // 1. 先注入 UTF-8 编码初始化
        "-include",
        "${workspaceFolder}/common/console_utf8.h",
        // 2. 再注入退出暂停逻辑
        "-include",
        "${workspaceFolder}/common/console_pause.h",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}