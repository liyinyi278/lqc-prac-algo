            "environment": [
                {
                    "name": "PLATFORM",
                    "value": "x64"
                }
            ],
            //"externalConsole": true,
            "console": "integratedTerminal",
            "preLaunchTask": "MSVC-64 - 构建项目",
            "logging": {
                "moduleLoad": false,
                "trace": false
            }
        },
